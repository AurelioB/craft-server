# Copy to .env and adjust. Values below are examples, not requirements.
# Host directories must exist before `docker compose up` (they are never created or chowned
# automatically); see docs/install.md. Relative paths resolve from this project directory.
# Paths may contain spaces; do not add quotes unless the value itself contains a '#'.

# Process identity for both services (numeric, non-root).
RUN_UID=1000
RUN_GID=10000
# Optional per-service overrides. Different identities need compatible group permissions;
# `doctor` checks this.
#WEB_UID=
#WEB_GID=
#UPDATER_UID=
#UPDATER_GID=
# Optional extra group for each service (for example a shared media group).
#WEB_SUPPLEMENTAL_GID=
#UPDATER_SUPPLEMENTAL_GID=

# Permission bits removed from files the updater creates (0002 keeps group write).
FILE_UMASK=0002

# Host directories (bind-mount sources).
CONFIG_DIR=/srv/craft-apps/config
DATA_DIR=/srv/craft-apps/data
STATE_DIR=/srv/craft-apps/state
CACHE_DIR=/srv/craft-apps/cache
WORK_DIR=/srv/craft-apps/work
# Optional persistent logs: also set COMPOSE_FILE=compose.yaml:compose.logs.yaml
#LOG_DIR=/srv/craft-apps/logs
#COMPOSE_FILE=compose.yaml:compose.logs.yaml

# Process working directories inside the containers.
#WEB_WORKING_DIR=/tmp
#UPDATER_WORKING_DIR=/srv/work

# Published HTTP listener. Keep it on loopback (or a private address) behind an HTTPS proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

#LOG_LEVEL=info
