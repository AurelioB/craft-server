# Copy to .env and adjust. Values below are examples, not requirements.
# Host directories must exist before `docker compose up` (they are never created or chowned
# automatically); see docs/install.md. Relative paths resolve from this project directory.
# Paths may contain spaces; do not add quotes unless the value itself contains a '#'.

# Process identity (numeric, non-root).
RUN_UID=1000
RUN_GID=10000
# Optional extra group (for example a shared group on the data directories).
#SUPPLEMENTAL_GID=

# Permission bits removed from files the server creates (0002 keeps group write).
FILE_UMASK=0002

# Host directories (bind-mount sources).
CONFIG_DIR=/srv/craft-apps/config
DATA_DIR=/srv/craft-apps/data
STATE_DIR=/srv/craft-apps/state
CACHE_DIR=/srv/craft-apps/cache
WORK_DIR=/srv/craft-apps/work
# Optional persistent logs: also set COMPOSE_FILE=compose.yaml:compose.logs.yaml
#LOG_DIR=/srv/craft-apps/logs
#COMPOSE_FILE=compose.yaml:compose.logs.yaml

# Working directory of the process inside the container.
#WORKING_DIR=/srv/work

# Published HTTP listener. 0.0.0.0 = every host interface (LAN, VPN, …); use 127.0.0.1 to keep it
# local when an HTTPS reverse proxy on this machine fronts it. Docker-published ports bypass
# host firewalls such as ufw.
BIND_ADDRESS=0.0.0.0
PORT=8080
# Separate administration port, for config.toml [admin] listen = "0.0.0.0:8081". Published only
# with COMPOSE_FILE=compose.yaml:compose.admin-port.yaml (plus compose.logs.yaml if used).
# A different port is a different browser origin, so app code never runs where admins sign in.
#ADMIN_PORT=8081
#ADMIN_BIND_ADDRESS=

#LOG_LEVEL=info
